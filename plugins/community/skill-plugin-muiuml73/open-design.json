{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "skill-plugin-muiuml73",
  "title": "产物规范与模板",
  "version": "0.1.0",
  "description": "每个复刻子项目（`当前项目目录/`）的标准产物。",
  "od": {
    "kind": "skill",
    "taskKind": "new-generation",
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ]
    },
    "capabilities": [
      "prompt:inject"
    ]
  }
}
